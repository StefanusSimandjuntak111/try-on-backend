# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=AI Try-On Backend
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
POSTGRES_USER=tryon_user
POSTGRES_PASSWORD=tryon_password
POSTGRES_DB=tryon_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tryon_user:tryon_password@localhost:5432/tryon_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Storage (S3/MinIO) Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_MODELS=models
S3_BUCKET_GARMENTS=garments
S3_BUCKET_RESULTS=results
S3_REGION=us-east-1
S3_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ML Models Configuration
ML_DEVICE=cpu
# For GPU support, set ML_DEVICE=cuda
HRVITON_CHECKPOINT=./weights/hrviton.pth
SCHP_CHECKPOINT=./weights/schp.pth
OPENPOSE_CHECKPOINT=./weights/openpose.pth
U2NET_CHECKPOINT=./weights/u2net.pth

# Processing Configuration
MAX_IMAGE_SIZE=2048
THUMBNAIL_SIZE=256
CACHE_TTL=3600

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security Configuration
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# API Port
API_PORT=8000
